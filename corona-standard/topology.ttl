@prefix corona: <http://example.org/standards/corona/metrics#> .
@prefix bacnet: <https://data.ashrae.org/bacnet/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

corona:NetworkDevice a rdfs:Class ; rdfs:label "Observed network device" .
corona:BroadcastAddress a rdfs:Class ; rdfs:label "BACnet broadcast address" .
corona:ModbusTcpClient a rdfs:Class ; rdfs:subClassOf corona:NetworkDevice .
corona:ModbusTcpServer a rdfs:Class ; rdfs:subClassOf corona:NetworkDevice .
corona:ModbusTcpGateway a rdfs:Class ; rdfs:subClassOf corona:ModbusTcpServer .
corona:ModbusRtuUnit a rdfs:Class ; rdfs:subClassOf corona:NetworkDevice .
corona:CommunicationEdge a rdfs:Class ; rdfs:label "Directed observed device communication" .
corona:MessageObservation a rdfs:Class ; rdfs:label "Count of one message type on an edge" .

corona:address a rdf:Property ; rdfs:domain corona:NetworkDevice ; rdfs:range xsd:string .
corona:routesTo a rdf:Property ; rdfs:domain corona:ModbusTcpGateway ; rdfs:range corona:ModbusRtuUnit .
corona:sourceDevice a rdf:Property ; rdfs:domain corona:CommunicationEdge ; rdfs:range corona:NetworkDevice .
corona:destinationDevice a rdf:Property ; rdfs:domain corona:CommunicationEdge ; rdfs:range corona:NetworkDevice .
corona:protocol a rdf:Property ; rdfs:domain corona:CommunicationEdge ; rdfs:range xsd:string .
corona:messageCount a rdf:Property ; rdfs:domain corona:CommunicationEdge ; rdfs:range xsd:nonNegativeInteger .
corona:hasMessageObservation a rdf:Property ; rdfs:domain corona:CommunicationEdge ; rdfs:range corona:MessageObservation .
corona:messageType a rdf:Property ; rdfs:domain corona:MessageObservation ; rdfs:range xsd:string .
corona:count a rdf:Property ; rdfs:domain corona:MessageObservation ; rdfs:range xsd:nonNegativeInteger .

bacnet:Device rdfs:subClassOf corona:NetworkDevice .
